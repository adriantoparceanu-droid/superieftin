NODE_ENV=development
DOMAIN=localhost:3000

# PostgreSQL — local: Homebrew (fara parola)
# Homebrew PostgreSQL: inlocuieste <user> cu userul tau macOS (ex: cosmin)
DATABASE_URL=postgresql://<user>@localhost:5432/superieftin

# Redis — local: Homebrew
REDIS_URL=redis://localhost:6379

# Profitshare (import produse: feed CSV/XML + verificari de pret prin API)
PROFITSHARE_API_USER=
PROFITSHARE_API_KEY=
# Sincronizare catalog din feed-uri (feed-urile se regenereaza ~03:00)
FEED_SYNC_CRON=0 4 * * *
# Verificare preturi produse prioritare (alerte + click-uri recente)
PRICE_CHECK_INTERVAL_HOURS=3
PRICE_CHECK_LIMIT=150

# Telegram (Faza 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=  # avertizari catre proprietar (magazine, garda reclamelor); gol = nu se trimit

# Google Analytics 4 (se incarca DOAR in productie)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin dashboard (/admin)
ADMIN_SESSION_SECRET=    # openssl rand -hex 32
UPLOAD_DIR=              # director partajat web<->worker pentru feed-uri incarcate manual

# Afiliere (Faza 3)
AFFILIATE_NETWORK=profitshare
AFFILIATE_ID=

# Google Ads (program Ads — vezi docs/ads-program/REGULI.md). Fara developer token, fara MCC.
ADS_ENV=test                       # test = orice scriere pleaca cu validate_only
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=          # npm run ads:auth (scope adwords + datamanager)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID_PROD=2760086909
GOOGLE_ADS_CONVERSION_ACTION_ID=   # actiunea „Comision afiliere”, fost „Comision Profitshare” — acelasi ID (npm run ads:conversion-action)
# tracking:sync automat (job zilnic): implicit DOAR validate_only; trimiterea reala cere
# TRACKING_SYNC_AUTO_SEND=1 SI ADS_ENV=prod (decizia proprietarului)
TRACKING_SYNC_AUTO_SEND=
TRACKING_SYNC_CRON=30 6 * * *

# IndexNow (Bing/Yandex) — anunta paginile de ghid publicate/actualizate din /admin/ghiduri.
# Optional: gol = nu se trimite nimic. Genereaza o data: openssl rand -hex 16
# Cheia se publica automat la https://www.superieftin.ro/indexnow-key.txt
INDEXNOW_KEY=

# Garda zilnica a reclamelor (job ads-guard, manual: npm run ads:guard): verifica paginile de
# destinatie ale grupurilor active si pune pe pauza grupurile care nu mai corespund (+ Telegram
# la TELEGRAM_ADMIN_CHAT_ID). Nu activeaza niciodata nimic.
ADS_GUARD_CRON=0 7 * * *
# EXCEPTIE de la regula 4, cere ACORDUL proprietarului: cu ADS_ENV=test, pauza gărzii e reala
# DOAR daca ADS_GUARD_REAL_PAUSE=1 (doar status=PAUSED, prin pauseOnly). Gol = doar alerta.
ADS_GUARD_REAL_PAUSE=

# Statistici GA4 in admin (/admin/statistici; job ga4-sync zilnic, DOAR citire). Gol = jobul sare.
# Configurare: docs/ghid-ga4-statistici-admin.md. Test: cd worker && npm run ga4:check
GA4_PROPERTY_ID=                   # numeric, din GA4 → Admin → Detalii proprietate (NU G-…)
GA4_SERVICE_ACCOUNT_JSON=          # cheia contului de serviciu in base64: base64 -i cheie.json | tr -d '\n'
GA4_SYNC_CRON=15 6 * * *
# Optional: proprietatea Search Console (gol = aleasa automat, sc-domain:superieftin.ro intai)
GSC_SITE_URL=

# Protectia anti-roboti pe /go/ (clickuri spre magazine). Toate optionale — gol = implicit.
# Secretul tokenului JS de pe butonul „Vezi oferta”: openssl rand -hex 32
# Gol = derivat automat din ADMIN_SESSION_SECRET; fara niciunul = verificarea tokenului e oprita.
GO_TOKEN_SECRET=
# Comutator de urgenta: 0 = opreste cerinta de token (limita de viteza ramane activa)
GO_TOKEN_CHECK=
# Header `x-go-test-token: <valoare>` → trece fara limita si fara token, click marcat intern.
# Gol = exceptia e dezactivata. Genereaza: openssl rand -hex 24 (NU o pune in cod/commit)
GO_TEST_TOKEN=
# Limita per IP pe /go/ (implicit 20/min si 120/ora) si pe /api/go-token (60/min, 600/ora)
GO_RATE_PER_MIN=
GO_RATE_PER_HOUR=
GO_TOKEN_RATE_PER_MIN=
GO_TOKEN_RATE_PER_HOUR=
# Cat asteptam Redis (ms) inainte sa lasam cererea sa treaca (fail-open). Implicit 150
GO_RATE_REDIS_TIMEOUT_MS=

# Alerte de pret pe EMAIL (double opt-in, digest zilnic). Agnostic de furnizor: orice SMTP
# (Brevo, Amazon SES, Postmark, Resend...). Alertele pe email sunt ACTIVE doar daca exista toate:
# SMTP_HOST + EMAIL_FROM + ALERT_TOKEN_SECRET (in web SI worker). Lipseste una = formularul nu apare
# pe site, workerul nu trimite nimic. Pe domeniu: SPF + DKIM + DMARC (vezi furnizorul).
SMTP_HOST=
SMTP_PORT=                         # implicit 587 (STARTTLS); 465 = TLS direct
SMTP_SECURE=                       # optional: 1 = TLS direct (implicit doar pe portul 465)
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=                        # ex. superieftin.ro <alerte@superieftin.ro> (domeniu verificat la furnizor)
EMAIL_REPLY_TO=                    # optional, ex. contact@superieftin.ro
# Secretul linkurilor din emailuri (confirmare, Alertele mele, dezabonare): openssl rand -hex 32
# ACELASI in web si worker. Schimbarea lui invalideaza linkurile din emailurile deja trimise.
ALERT_TOKEN_SECRET=
# Plafon: cel mult un email de alerte la atatea ore per abonat (implicit 24 = unul pe zi)
EMAIL_ALERT_MIN_INTERVAL_HOURS=
# Trecerea periodica a digestului (implicit la fiecare ora, minutul 5); se ruleaza si dupa sync-uri
EMAIL_DIGEST_CRON=
# Limita per IP pe formularul de alerta / cererea de link nou (implicit 5/min si 20/ora)
ALERT_RATE_PER_MIN=
ALERT_RATE_PER_HOUR=
