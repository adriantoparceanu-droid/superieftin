NODE_ENV=development
DOMAIN=localhost:3000

# PostgreSQL — local: Homebrew (fara parola)
# Homebrew PostgreSQL: inlocuieste <user> cu userul tau macOS (ex: cosmin)
DATABASE_URL=postgresql://<user>@localhost:5432/superieftin

# Redis — local: Homebrew
REDIS_URL=redis://localhost:6379

# Profitshare (import produse: feed CSV/XML + verificari de pret prin API)
PROFITSHARE_API_USER=
PROFITSHARE_API_KEY=
# Sincronizare catalog din feed-uri (feed-urile se regenereaza ~03:00)
FEED_SYNC_CRON=0 4 * * *
# Verificare preturi produse prioritare (alerte + click-uri recente)
PRICE_CHECK_INTERVAL_HOURS=3
PRICE_CHECK_LIMIT=150

# Telegram (Faza 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=  # avertizari catre proprietar (magazine, garda reclamelor); gol = nu se trimit

# Google Analytics 4 (se incarca DOAR in productie)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin dashboard (/admin)
ADMIN_SESSION_SECRET=    # openssl rand -hex 32
UPLOAD_DIR=              # director partajat web<->worker pentru feed-uri incarcate manual

# Afiliere (Faza 3)
AFFILIATE_NETWORK=profitshare
AFFILIATE_ID=

# Google Ads (program Ads — vezi docs/ads-program/REGULI.md). Fara developer token, fara MCC.
ADS_ENV=test                       # test = orice scriere pleaca cu validate_only
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=          # npm run ads:auth (scope adwords + datamanager)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID_PROD=2760086909
GOOGLE_ADS_CONVERSION_ACTION_ID=   # actiunea „Comision Profitshare” (npm run ads:conversion-action)
# tracking:sync automat (job zilnic): implicit DOAR validate_only; trimiterea reala cere
# TRACKING_SYNC_AUTO_SEND=1 SI ADS_ENV=prod (decizia proprietarului)
TRACKING_SYNC_AUTO_SEND=
TRACKING_SYNC_CRON=30 6 * * *
# Garda zilnica a reclamelor (job ads-guard, manual: npm run ads:guard): verifica paginile de
# destinatie ale grupurilor active si pune pe pauza grupurile care nu mai corespund (+ Telegram
# la TELEGRAM_ADMIN_CHAT_ID). Nu activeaza niciodata nimic.
ADS_GUARD_CRON=0 7 * * *
# EXCEPTIE de la regula 4, cere ACORDUL proprietarului: cu ADS_ENV=test, pauza gărzii e reala
# DOAR daca ADS_GUARD_REAL_PAUSE=1 (doar status=PAUSED, prin pauseOnly). Gol = doar alerta.
ADS_GUARD_REAL_PAUSE=
